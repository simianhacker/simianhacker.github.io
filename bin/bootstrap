#!/usr/bin/env bash
set -euo pipefail

RUBY_VERSION="$(cat "$(dirname "$0")/../.ruby-version")"

# ── Helpers ───────────────────────────────────────────────────────────────────

info()    { printf '\033[1;34m→\033[0m  %s\n' "$*"; }
success() { printf '\033[1;32m✓\033[0m  %s\n' "$*"; }
die()     { printf '\033[1;31m✗\033[0m  %s\n' "$*" >&2; exit 1; }

# ── rbenv ─────────────────────────────────────────────────────────────────────

if ! command -v rbenv &>/dev/null; then
  info "rbenv not found — installing via Homebrew..."
  if ! command -v brew &>/dev/null; then
    die "Homebrew is required. Install it from https://brew.sh and re-run."
  fi
  brew install rbenv ruby-build
fi

export PATH="$HOME/.rbenv/bin:$HOME/.rbenv/shims:$PATH"
eval "$(rbenv init -)"

# ── Ruby version ──────────────────────────────────────────────────────────────

if ! rbenv versions --bare | grep -qx "$RUBY_VERSION"; then
  info "Installing Ruby $RUBY_VERSION (this takes a few minutes)..."
  rbenv install "$RUBY_VERSION"
else
  success "Ruby $RUBY_VERSION already installed"
fi

rbenv local "$RUBY_VERSION"

# ── Bundler + gems ────────────────────────────────────────────────────────────

cd "$(dirname "$0")/.."

if ! gem list bundler --installed &>/dev/null; then
  info "Installing Bundler..."
  gem install bundler --no-document
fi

info "Running bundle install..."
bundle install

success "Bootstrap complete. Run  bin/serve  to start the local preview."
