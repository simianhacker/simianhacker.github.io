#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

export PATH="$HOME/.rbenv/bin:$HOME/.rbenv/shims:$PATH"
eval "$(rbenv init -)" 2>/dev/null || true

if ! bundle check &>/dev/null; then
  echo "Dependencies out of date — run  bin/bootstrap  first."
  exit 1
fi

echo "Building site..."
bundle exec jekyll build

echo ""
echo "Built to _site/. To preview the output:"
echo "  open _site/index.html"
